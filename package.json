{
  "name": "@glazecalc/catalog",
  "version": "0.2.0",
  "description": "Glazecalc's tables and information for the glaze and clay-body chemistry core: oxides, cones, limits and Stull, densities, expansion, clay-body tables, policy, the English of every code, text readers and the standard materials.",
  "license": "MIT",
  "author": "Aaron Filson / Candling Development Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaronFilson/glazecalc-catalog.git"
  },
  "homepage": "https://github.com/AaronFilson/glazecalc-catalog#readme",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./host": "./host/index.ts",
    "./locale": "./locale/index.ts",
    "./text": "./text/index.ts",
    "./standard": "./standard/index.ts",
    "./data/*": "./data/*",
    "./package.json": "./package.json"
  },
  "files": [
    "**/*.ts",
    "!test/**",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "data/",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"./**\" --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"../core/**\" --test-coverage-exclude=\"scripts/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/*.test.js\"",
    "typecheck": "tsc -p . && npm run typecheck:7",
    "typecheck:7": "node node_modules/typescript7/bin/tsc -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:outputs": "node scripts/outputs.mjs",
    "check:engines": "node scripts/outputs.mjs --engines"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "typescript7": "npm:typescript@7.0.2"
  }
}
